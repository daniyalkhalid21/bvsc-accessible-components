{
  "name": "bvsc-accessible-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "serve-storybook": "http-server storybook-static -p 6006",
    "test": "vitest run",
    "contrast": "node scripts/contrast-check.mjs",
    "audit": "node scripts/audit-stories.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "storybook": "^8.6.18",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  },
  "description": "Accessible (WCAG 2.2 AA) React component library for Boutique Veterinary Supply Company",
  "engines": {
    "node": ">=18"
  }
}